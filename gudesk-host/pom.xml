<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gudesk</groupId>
        <artifactId>gudesk</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>gudesk-host</artifactId>
    <packaging>jar</packaging>

    <name>GuDesk :: Host</name>

    <properties>
        <!-- 目标平台裁剪：仅拉取 Linux/Windows x86_64 两平台原生库（见下方显式 classifier 依赖）。
             注意：Maven 对传递依赖 pom 中 profile 的激活仅响应命令行 -Djavacpp.platform=...，
             pom 内属性不会生效，因此这里不用 -platform 聚合，而是直接声明 classifier 依赖 -->
        <javacpp.platform>linux-x86_64,windows-x86_64</javacpp.platform>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.gudesk</groupId>
            <artifactId>gudesk-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JavaCV（Java 类，版本由父 POM dependencyManagement 管理） -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
        </dependency>
        <!-- FFmpeg Java 绑定（Java 类；libx264 编码器位于下方 -gpl 原生库中） -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
        </dependency>
        <!-- FFmpeg 原生库（GPL 构建内置 libx264），按平台显式裁剪，替代 -platform 全平台聚合 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>${ffmpeg.version}</version>
            <classifier>linux-x86_64-gpl</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>${ffmpeg.version}</version>
            <classifier>windows-x86_64-gpl</classifier>
        </dependency>
        <!-- JavaCPP 原生库（jnijavacpp），与 FFmpeg 平台一致 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.gudesk.host.HostApp</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- 将运行时依赖复制到 target/lib，供 java -jar ...（Class-Path: lib/...）执行 selftest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
