<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gudesk</groupId>
        <artifactId>gudesk</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>gudesk-viewer</artifactId>
    <packaging>jar</packaging>

    <name>GuDesk :: Viewer</name>

    <properties>
        <!-- 目标平台裁剪：仅拉取 Linux/Windows x86_64 两平台原生库（见下方显式 classifier 依赖）。
             注意：Maven 对传递依赖 pom 中 profile 的激活仅响应命令行 -Djavacpp.platform=...，
             pom 内属性不会生效，因此这里不用 -platform 聚合，而是直接声明 classifier 依赖 -->
        <javacpp.platform>linux-x86_64,windows-x86_64</javacpp.platform>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.gudesk</groupId>
            <artifactId>gudesk-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JavaFX 21（版本属性由父 POM 统一管理；父 POM dependencyManagement 条目无 classifier，
             与带 classifier 的依赖不匹配，因此此处显式写版本。无 classifier 的 javafx jar 为
             空壳不含平台实现，这里声明带 linux/win classifier 的平台依赖；
             javafx-base 会由 javafx-graphics 的平台 pom 传递引入） -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <!-- JavaCV（Java 类，版本由父 POM dependencyManagement 管理） -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
        </dependency>
        <!-- FFmpeg Java 绑定（Java 类；H.264 解码器位于下方 -gpl 原生库中） -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
        </dependency>
        <!-- FFmpeg 原生库（GPL 构建，与 host 端编码一致），按平台显式裁剪，
             替代 -platform 全平台聚合 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>${ffmpeg.version}</version>
            <classifier>linux-x86_64-gpl</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>${ffmpeg.version}</version>
            <classifier>windows-x86_64-gpl</classifier>
        </dependency>
        <!-- JavaCPP 原生库（jnijavacpp），与 FFmpeg 平台一致 -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
            <classifier>windows-x86_64</classifier>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.gudesk.viewer.ViewerApp</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- 将运行时依赖复制到 target/lib，供 java -jar ...（Class-Path: lib/...）执行 selftest/smoke -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- mvn javafx:run 直接运行主控端 UI（自动配置 JavaFX 平台模块路径） -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx-maven-plugin.version}</version>
                <configuration>
                    <mainClass>com.gudesk.viewer.ViewerApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
